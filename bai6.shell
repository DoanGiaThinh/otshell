#!/bin/bash

if [ $# -ne 2 ]; then
	echo "Ban phai nhap dung 2 tham so"
	exit 1
fi

str=$1
n=$2

if [[ "$str" =~ [[:space:]] ]]; then
	echo "co chua khoang trang"
	exit 1
fi

if ! [[ "$n" =~ ^[0-9]+$ ]]; then
	echo "khong pha la so nguyen duong"
	exit 1
fi

for ((i = 0; i < n; i++))
do
	echo "$str"
done
